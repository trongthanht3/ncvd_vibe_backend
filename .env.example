# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Configuration - Main Application
POSTGRES_DB=hackathon_db
POSTGRES_USER=hackathon_user
POSTGRES_PASSWORD=hackathon_pass
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://hackathon_user:hackathon_pass@localhost:5432/hackathon_db


# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_WEB_PORT=9092
MILVUS_USERNAME=
MILVUS_PASSWORD=

# MinIO Configuration (for Milvus)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PORT=9001
MINIO_CONSOLE_PORT=9091

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Development
RELOAD=true